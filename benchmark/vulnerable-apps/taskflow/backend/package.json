    "jsonwebtoken": "8.5.1",
    "libxmljs": "0.19.7",
    "lodash": "4.17.15",
    "multer": "1.4.4",
    "pg": "^8.11.3",
    "stripe": "^14.10.0",
    "uuid": "^9.0.1"
